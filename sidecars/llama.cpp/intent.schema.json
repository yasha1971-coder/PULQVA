{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PULQVA interpreted intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["query", "choice_mode"],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "choice_mode": {
      "type": "string",
      "enum": ["ask", "autopilot"]
    }
  }
}
